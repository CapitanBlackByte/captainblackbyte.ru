# Токен от @BotFather
BOT_TOKEN=

# Telegram-аккаунт, в чат которого приходят заявки. Чат назначится сам после первого сообщения боту
MANAGER_USERNAME=

# ID чата для заявок, если это группа. Узнать его: команда /id в этом чате
MANAGER_CHAT_ID=

# Ссылка на политику обработки персональных данных, показывается перед согласием
PRIVACY_URL=

# Адрес релея, если сервер не достаёт до api.telegram.org. Пример: https://relay.example.com
TELEGRAM_API_ROOT=

# Файл с заявками. По умолчанию data/state.json
DATA_FILE=

# Откуда бот забирает заявки с формы на сайте, и ключ доступа, тот же, что в inbox/.env на сервере сайта
INBOX_URL=
INBOX_TOKEN=
